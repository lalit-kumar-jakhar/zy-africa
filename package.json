{
  "name": "zyneto-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-css.js && next dev --webpack",
    "dev:watch": "concurrently \"pnpm run watch:css\" \"pnpm run dev\"",
    "build": "node scripts/copy-css.js && node scripts/minify-public-js.js && next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "watch:css": "node scripts/watch-css.js",
    "copy:css": "node scripts/copy-css.js"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "hamburger-react": "^2.5.2",
    "lenis": "^1.3.23",
    "next": "16.3.1",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-fast-marquee": "^1.6.5",
    "react-google-recaptcha": "^3.1.0",
    "react-icons": "^5.6.0",
    "react-phone-input-2": "^2.15.1",
    "react-slick": "^0.31.0",
    "react-toastify": "^11.1.0",
    "slick-carousel": "^1.8.1",
    "tailwind-merge": "^3.6.0",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/react-slick": "^0.23.13",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "cssnano": "^8.0.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "terser": "^5.48.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.10.0",
  "pnpm": {
    "overrides": {
      "@isaacs/brace-expansion": "^5.0.1",
      "brace-expansion": "^1.1.18",
      "minimatch@10>brace-expansion": "^5.0.1",
      "flatted": "3.4.2",
      "picomatch": "4.0.4",
      "yaml": "2.8.3",
      "postcss": "^8.5.25",
      "sharp": "^0.35.3",
      "svgo": "^4.0.2",
      "nanoid": "3.3.18",
      "js-yaml": "4.3.1"
    }
  },
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "samsung >= 19"
  ]
}
