# Node modules
node_modules/

# pnpm files
.pnpm-debug.log*
.pnpm-store/

# Build output
.next/
out/
build/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing coverage
coverage/

# Vercel
.vercel/

# Environment variables (.env.local, .env.production, etc.)
.env
.env.*
