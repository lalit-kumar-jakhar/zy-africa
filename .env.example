# Copy to .env and fill in. Never commit .env itself - it is gitignored.
# Names only; no values belong in this file.

# Backend API origin. Required at BUILD time: src/app/blog/page.tsx and the
# blog detail/category routes non-null assert it, so a build without it fails
# while fetching blog data.
NEXT_PUBLIC_BASE_URL=

# Public site key for reCAPTCHA v3. Read by src/utils/recaptcha.ts.
# The matching SECRET key is server-side only and must never appear here or in
# any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY_V3=

# S3 bucket base URL. Used by next.config.ts for images.remotePatterns, the CSP
# img-src directive, and the /sitemap.xml + /sitemap_blogs.xml rewrites.
# Must be a bare https origin with no trailing slash, e.g. https://bucket.s3.amazonaws.com
S3_BASE_URL=

# NOTE: the GTM container ID is hardcoded in src/app/layout.tsx by design, not
# read from here. The tag stack only loads when VERCEL_ENV is exactly
# "production": there is no NODE_ENV fallback, so a local `next start` loads no
# tags at all and nothing on a developer machine can reach the live property.

# NOTE: do not set NODE_ENV here. Next sets it per command (dev/build/start);
# pinning it in .env is inert for Next itself but silently misleads any other
# tool that loads this file.

# Server-only key for the blog management API (never NEXT_PUBLIC_)
BLOG_MANAGE_API_KEY=
